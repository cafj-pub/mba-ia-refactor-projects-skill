# Copie para .env (ou exporte no shell) e ajuste os valores.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
CORS_ORIGINS=*
# Token exigido no header X-Admin-Token de POST /admin/reset-db (vazio = endpoint desabilitado)
ADMIN_TOKEN=
# Senha do usuário admin@loja.com criado no seed (vazio = senha aleatória)
SEED_ADMIN_PASSWORD=
APP_ENV=development
LOG_LEVEL=INFO
