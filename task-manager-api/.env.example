# Copie para .env e ajuste os valores (carregado automaticamente via python-dotenv).
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=*
LOG_LEVEL=INFO
# SMTP vazio = notificações por e-mail desabilitadas (apenas log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Validade do token de login, em segundos
TOKEN_MAX_AGE_SECONDS=3600
# Senha do admin (joao@email.com) criado pelo seed.py; vazia = senha aleatória
SEED_ADMIN_PASSWORD=
