# Copie para .env (ou exporte no shell) e ajuste os valores.
PORT=3000
# ':memory:' (padrão) ou caminho de arquivo SQLite
DATABASE_FILE=:memory:
# Chave do gateway de pagamento (nunca commitar o valor real)
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas (vazio = rotas bloqueadas)
ADMIN_TOKEN=
LOG_LEVEL=info
